{
	"name": "additional-order-costs-for-woocommerce",
	"title": "Additional Order Costs for WooCommerce",
	"version": "1.0.0",
	"description": "Whether it's an extra invoice, or a credit from a merchant related to an order. Sometimes you just need a couple extra cost fields for your reporting.",
	"author": {
		"name": "TheRiteSites",
		"url": "https://www.theritesites.com?"
	},
	"license": "GPL-2.0-only",
	"files": [
		"assets",
		"woo-includes",
		"includes",
		"build",
		"languages",
		"index.php",
		"cmb2",
		"additional-order-costs-for-woocommerce.php",
		"LICENSE.txt",
		"README.txt",
		"uninstall.php"
	],
	"scripts": {
		"start-c": "wp-scripts build --mode=development --env NODE_ENV=development --env LOC=corsair --watch",
		"start-m": "wp-scripts build --mode=development --env NODE_ENV=development --env LOC=mac --watch",
		"build-c": "wp-scripts build --mode=production --env NODE_ENV=production --env LOC=corsair",
		"build-m": "wp-scripts build --mode=production --env NODE_ENV=production --env LOC=mac",
		"start-m1": "wp-scripts start --mode=development --env NODE_ENV=development --env LOC=m1 ",
		"start-m1-nw": "wp-scripts build --mode=development --env NODE_ENV=development --env LOC=m1",
		"build-m1": "wp-scripts build --mode=production --env NODE_ENV=production --env LOC=m1",
		"plugin-zip": "wp-scripts plugin-zip"
	},
	"devDependencies": {
		"@wordpress/scripts": "^27",
		"copy-webpack-plugin": "^12.0.2",
		"webpack-cli": "^4.10.0"
	}
}
